# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_HEAT_TOPIC=heat-measurements

# Google Earth Engine (optional — without these the service uses deterministic
# mock land-surface-temperature data so the pipeline stays runnable).
GEE_PROJECT=your-gcp-project-id
GEE_SERVICE_ACCOUNT=earth-engine@your-gcp-project-id.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_FILE=/absolute/path/to/service-account-key.json
